{
  "name": "git-guides",
  "version": "1.0.0",
  "private": true,
  "description": "Panduan Git interaktif berbahasa Indonesia",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/prepare-assets.mjs",
    "start": "npm run dev",
    "preview": "astro preview",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "astro build",
    "check": "node scripts/check.mjs && astro check",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "format": "prettier --plugin prettier-plugin-astro --write \"src/**/*.{ts,js,cjs,json,astro}\" \"scripts/*.mjs\" \"tests/**/*.{cjs,ts}\" astro.config.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "astro": "7.4.11",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
